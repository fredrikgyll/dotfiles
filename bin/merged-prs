#!/usr/bin/env bash
set -euo pipefail

n="${1:-20}"
tty=false
[ -t 1 ] && tty=true

# The search API cannot sort by merge time. A PR is updated when it merges,
# so the most recently updated PRs hold the most recently merged ones.
gh search prs \
  --author=@me \
  --merged \
  --sort=updated \
  --limit="$(( n * 3 > 100 ? n * 3 : 100 ))" \
  --json=repository,number,title,url,closedAt \
  | jq -r --argjson n "$n" --argjson tty "$tty" '
      def link: if $tty then "\u001b]8;;\(.url)\u001b\\#\(.number)\u001b]8;;\u001b\\" else "#\(.number)" end;
      sort_by(.closedAt) | reverse | .[:$n]
      | group_by(.repository.nameWithOwner)
      | sort_by(map(.closedAt) | max) | reverse
      | .[]
      | "\n\(.[0].repository.nameWithOwner)",
        (.[] | "  \(.closedAt[:16] | sub("T"; " "))  \(link)  \(.title)")
    '
