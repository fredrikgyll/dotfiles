#!/usr/bin/env bash
# Create a new Python project from the mise + uv scaffold.
set -euo pipefail

usage() {
  echo "usage: newpy <name> [parent-dir]" >&2
  exit 2
}

[ $# -ge 1 ] && [ $# -le 2 ] || usage
name=$1
parent=${2:-$PWD}
template=${NEWPY_TEMPLATE:-git@github.com:fredrikgyll/python-template.git}

case $name in
  *[!a-zA-Z0-9_-]* | -* | "") usage ;;
esac

dest=$parent/$name
pkg=${name//-/_}

if [ -e "$dest" ]; then
  echo "newpy: $dest already exists" >&2
  exit 1
fi

git clone --depth 1 --quiet "$template" "$dest"
cd "$dest"
rm -rf .git uv.lock

mv src/skel_proj "src/$pkg"
mv tests/test_skel_proj.py "tests/test_$pkg.py"
sed -i '' -e "s/skel_proj/$pkg/g" -e "s/skel-proj/$name/g" \
  pyproject.toml README.md "src/$pkg/__init__.py" "tests/test_$pkg.py"

git init -b main --quiet
mise trust --quiet
mise install
mise run install
git add -A
git commit -qm "chore: scaffold $name"

echo "newpy: created $dest"
